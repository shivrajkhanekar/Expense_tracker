generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgres"
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  password     String
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id   String @id @default(cuid())
  name String @unique
}

model Transaction {
  id          String   @id @default(cuid())
  amount      Float
  type        String   // "income" or "expense"
  category    String
  description String
  date        DateTime
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}
